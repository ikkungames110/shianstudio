{
  "schema_version": "3.1.0",
  "features": [
    {
      "key": "eye_angle",
      "name": "目尻の傾斜",
      "low": "穏やかな垂れ目",
      "high": "穏やかなつり目",
      "definition": "目頭と目尻を結ぶ線の傾斜。正面・頭部水平で判定。",
      "phrases": [
        "gently downturned outer eye corners",
        "level outer eye corners",
        "gently upturned outer eye corners"
      ]
    },
    {
      "key": "eye_shape",
      "name": "目の縦横比",
      "low": "丸みのある目",
      "high": "切れ長の目",
      "definition": "目の開口部の横幅 / 縦幅。眼球の大きさとは分ける。",
      "phrases": [
        "rounded eye openings",
        "almond-shaped eye openings",
        "elongated eye openings"
      ]
    },
    {
      "key": "eye_size",
      "name": "目の相対面積",
      "low": "控えめな目の面積",
      "high": "存在感のある目の面積",
      "definition": "左右平均の眼裂面積 / 顔領域面積。縦横比とは別に調整。",
      "phrases": [
        "subtly sized eyes",
        "medium-sized eyes",
        "prominent large eyes"
      ]
    },
    {
      "key": "eye_spacing",
      "name": "目の間隔",
      "low": "やや寄り目",
      "high": "やや離れ目",
      "definition": "内眼角間距離 / 左右平均の眼裂横幅。",
      "phrases": [
        "slightly close-set eyes",
        "balanced eye spacing",
        "slightly wide-set eyes"
      ]
    },
    {
      "key": "upper_eyelid_crease",
      "name": "上まぶたの折り目",
      "low": "目立たない折り目",
      "high": "明瞭な折り目",
      "definition": "正面で見える折り目の明瞭さ。幅・一重二重の優劣は表さない。",
      "phrases": [
        "subtle upper-eyelid creases",
        "moderately visible upper-eyelid creases",
        "clearly visible upper-eyelid creases"
      ]
    },
    {
      "key": "lower_eyelid_fullness",
      "name": "下まぶたの膨らみ",
      "low": "なだらかな下まぶた",
      "high": "ふっくらした下まぶた",
      "definition": "睫毛直下の局所的な膨らみ。目の下の影やクマは含めない。",
      "phrases": [
        "smooth lower-eyelid contours",
        "moderate lower-eyelid fullness",
        "gently full lower eyelids"
      ]
    },
    {
      "key": "eyebrow_angle",
      "name": "眉の傾斜",
      "low": "水平に近い眉",
      "high": "眉尻に向け上がる眉",
      "definition": "眉頭から眉尻までの全体的な傾斜。眉山の曲率と分ける。",
      "phrases": [
        "nearly horizontal eyebrows",
        "slightly rising eyebrows",
        "distinctly rising eyebrows"
      ]
    },
    {
      "key": "eyebrow_arch",
      "name": "眉山の曲率",
      "low": "直線的な眉",
      "high": "なだらかなアーチ眉",
      "definition": "眉の中央部が眉頭・眉尻を結ぶ線から離れる度合い。",
      "phrases": [
        "straight eyebrow contours",
        "gently curved eyebrow contours",
        "arched eyebrow contours"
      ]
    },
    {
      "key": "eyebrow_thickness",
      "name": "眉の太さ",
      "low": "繊細な眉",
      "high": "しっかりした眉",
      "definition": "眉中央の見かけの太さ / 眼裂縦幅。色の濃さは固定。",
      "phrases": [
        "fine eyebrows",
        "medium-width eyebrows",
        "full eyebrows"
      ]
    },
    {
      "key": "eyebrow_eye_distance",
      "name": "眉と目の距離",
      "low": "近い",
      "high": "離れている",
      "definition": "瞳孔上での上まぶたと眉下縁の距離 / 眼裂縦幅。",
      "phrases": [
        "low eyebrow-to-eye spacing",
        "balanced eyebrow-to-eye spacing",
        "open eyebrow-to-eye spacing"
      ]
    },
    {
      "key": "face_length_width",
      "name": "顔の縦横比",
      "low": "短めの輪郭",
      "high": "長めの輪郭",
      "definition": "生え際中央〜顎先の高さ / 頬骨部の横幅。丸さ自体は別項目。",
      "phrases": [
        "a relatively short face outline",
        "an oval face outline",
        "a relatively long face outline"
      ]
    },
    {
      "key": "midface_ratio",
      "name": "中顔面の比率",
      "low": "短めの中顔面",
      "high": "長めの中顔面",
      "definition": "瞳孔を結ぶ水平線〜鼻下の距離 / 生え際〜顎先の高さ。",
      "phrases": [
        "a compact midface",
        "balanced midface proportions",
        "an elongated midface"
      ]
    },
    {
      "key": "lower_face_ratio",
      "name": "下顔面の比率",
      "low": "短めの下顔面",
      "high": "長めの下顔面",
      "definition": "鼻下〜顎先の距離 / 生え際〜顎先の高さ。中顔面との和に注意。",
      "phrases": [
        "a compact lower face",
        "balanced lower-face proportions",
        "an elongated lower face"
      ]
    },
    {
      "key": "jaw_width",
      "name": "下顎の横幅",
      "low": "細めの下顎",
      "high": "幅のある下顎",
      "definition": "左右下顎角間距離 / 頬骨部横幅。角張りとは独立。",
      "phrases": [
        "a narrow jaw",
        "a medium-width jaw",
        "a broad balanced jaw"
      ]
    },
    {
      "key": "jaw_angularity",
      "name": "下顎角の角張り",
      "low": "曲線的な下顎角",
      "high": "輪郭の明瞭な下顎角",
      "definition": "耳下から顎先への方向変化の明瞭さ。",
      "phrases": [
        "smooth curved jaw angles",
        "moderately defined jaw angles",
        "crisp defined jaw angles"
      ]
    },
    {
      "key": "chin_width",
      "name": "顎先の横幅",
      "low": "細めの顎先",
      "high": "幅のある顎先",
      "definition": "顎先直上の横幅 / 下顎横幅。前後方向の突出は扱わない。",
      "phrases": [
        "a slender chin",
        "a medium-width chin",
        "a broader chin"
      ]
    },
    {
      "key": "chin_roundness",
      "name": "顎先の丸み",
      "low": "先端がすっきりした顎",
      "high": "丸みのある顎",
      "definition": "顎先最下部の局所的な曲率。横幅と分ける。",
      "phrases": [
        "a softly tapered chin tip",
        "a gently contoured chin tip",
        "a rounded chin tip"
      ]
    },
    {
      "key": "cheekbone_prominence",
      "name": "頬骨の輪郭",
      "low": "控えめな頬骨",
      "high": "明瞭な頬骨",
      "definition": "正面での頬骨の輪郭・起伏の見え方。照明で誇張しない。",
      "phrases": [
        "subtle cheekbone contours",
        "moderately defined cheekbones",
        "clearly defined cheekbones"
      ]
    },
    {
      "key": "cheek_fullness",
      "name": "頬の膨らみ",
      "low": "すっきりした頬",
      "high": "ふっくらした頬",
      "definition": "頬骨下〜口横の軟部の膨らみ。体格は推定しない。",
      "phrases": [
        "sleek cheek contours",
        "moderately full cheeks",
        "gently full cheeks"
      ]
    },
    {
      "key": "nose_bridge_height",
      "name": "鼻筋の立体感",
      "low": "穏やかな鼻筋",
      "high": "通った鼻筋",
      "definition": "正面・同一照明での見かけの立体感。実測の鼻高ではない。",
      "phrases": [
        "a softly defined nasal bridge",
        "a moderately defined nasal bridge",
        "a well-defined nasal bridge"
      ]
    },
    {
      "key": "nose_width",
      "name": "鼻の横幅",
      "low": "細めの鼻",
      "high": "幅のある鼻",
      "definition": "小鼻外側間距離 / 内眼角間距離。",
      "phrases": [
        "a slender nose width",
        "a balanced nose width",
        "a slightly broader nose width"
      ]
    },
    {
      "key": "nose_tip_roundness",
      "name": "鼻先の丸み",
      "low": "すっきりした鼻先",
      "high": "丸みのある鼻先",
      "definition": "鼻尖の正面輪郭の丸み。鼻筋の高さとは独立。",
      "phrases": [
        "a refined tapered nose tip",
        "a softly contoured nose tip",
        "a gently rounded nose tip"
      ]
    },
    {
      "key": "mouth_width",
      "name": "口の横幅",
      "low": "小ぶりな口",
      "high": "幅のある口",
      "definition": "口角間距離 / 瞳孔間距離。閉口・無表情で判定。",
      "phrases": [
        "a petite mouth width",
        "a balanced mouth width",
        "a generous mouth width"
      ]
    },
    {
      "key": "lip_fullness",
      "name": "唇の厚み",
      "low": "薄めの唇",
      "high": "ふっくらした唇",
      "definition": "上下の赤唇部の合計高さ / 口角間距離。口紅で補わない。",
      "phrases": [
        "delicate lips",
        "moderately full lips",
        "full lips"
      ]
    },
    {
      "key": "upper_lip_share",
      "name": "上唇の配分",
      "low": "下唇主体",
      "high": "上下の厚みが近い",
      "definition": "上下赤唇高の合計に対する上唇高の割合。目標30〜48%を0〜1に対応。",
      "phrases": [
        "a clearly thinner upper lip than lower lip",
        "a moderately thinner upper lip than lower lip",
        "nearly equal upper and lower lip thickness"
      ]
    },
    {
      "key": "cupid_bow_definition",
      "name": "上唇中央の山",
      "low": "なだらかな山",
      "high": "明瞭な山",
      "definition": "上唇中央のM字輪郭の明瞭さ。口紅で補わない。",
      "phrases": [
        "a softly curved upper lip with a shallow Cupid bow",
        "a moderate Cupid bow",
        "a distinctly defined natural Cupid bow"
      ]
    }
  ],
